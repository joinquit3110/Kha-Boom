{
  "name": "@mathigon/textbooks",
  "version": "0.7.4",
  "description": "Mathigon Textbooks",
  "homepage": "https://mathigon.org/",
  "repository": "mathigon/textbooks",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "server": "ts-node khaboom-studio/server/serve.ts",
    "assets": "node khaboom-studio/build/index.js --assets --locales en",
    "watch": "node khaboom-studio/build/index.js --assets --watch --locales en",
    "start": "npm-run-all --parallel watch server",
    "translate": "node khaboom-studio/build/index.js --translate --key google-service-account.json",
    "lint": "eslint content --ext .ts",
    "lint-fix": "eslint content --ext .ts --fix"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@khaboom/studio": "file:./khaboom-studio",
    "@mathigon/boost": "1.2.27",
    "@mathigon/core": "1.1.19",
    "@mathigon/euclid": "1.2.0",
    "@mathigon/fermat": "1.1.20",
    "@mathigon/hilbert": "1.1.20",
    "@types/d3": "6.3.0",
    "@types/three": "0.91.14",
    "@types/topojson": "3.2.3",
    "npm-run-all2": "6.2.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.0",
    "eslint-config-google": "0.14.0",
    "eslint-plugin-import": "2.29.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}

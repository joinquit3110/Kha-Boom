extends _layout

block vars
  - var title = (section.title !== 'Introduction' ? section.title + ' – ' : '') + course.title
  - var description = course.description
  - var styles = ['/course.css', '/khaboom/styles.css', '/khaboom/custom-components.css', '/khaboom/enhanced-effects.css', `/content/${course.id}/styles.css`, '/course-custom.css']
  - var scripts = [`/content/${course.id}/functions.js`, '/course.js']
  - var thumbnail = `/content/${course.id}/thumbnails/${section.id}-${course.locale}.jpg`
  - var theme = (section.background && section.background.includes('dark')) ? 'dark' : undefined;
  - var htmlClass = (typeof htmlClass !== 'undefined' && htmlClass) ? htmlClass : ''

block header


block append head
  script(type="application/ld+json").
    {
      "@context": "http://schema.org",
      "@type": "CreativeWork",
      "name": "#{course.title}",
      "description": "#{course.description}",
      "thumbnailUrl": "https://#{config.domain}/#{course.hero}",
      "image": "https://#{config.domain}/#{course.icon}",
      "learningResourceType": "textbook",
      "interactivityType": "active",
      "isFamilyFriendly": true,
      "educationalUse": "self study",
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "student"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Kha-Boom! Interactive Learning",
        "logo": "https://#{config.domain}/khaboom/images/logokb.png"
      }
    }

block main
  //- Kha-Boom! Enhanced Course Layout
  .kb-course-wrapper
    //- Bubble background for enhanced visual appeal
    .bubble-background#bubbleContainer
      //- Bubbles will be added by JavaScript
    
    - var audioFile = (config.courses.audio && locale.id === 'en') ? cacheBust(`/content/${course.id}/audio/narration_en.mp3`) : undefined;
    x-course.kb-enhanced-course(id=course.id data-section=section.id data-goals=section.goals data-audio=audioFile data-reveal=(config.courses.revealAll ? 'true' : undefined))
      include ../../frontend/components/sidebar/sidebar

      article.kb-course-content(class=section.background lang=course.locale)
        if section.background
          .page-background

        //- Kha-Boom! Enhanced Course Header
        .kb-course-header
          .kb-course-title-wrapper
            h1.kb-course-title.kb-colorful-title #{section.title}
          

        .reveal-banner.off.kb-enhanced-banner
          .kb-banner-content
            span.kb-banner-icon 📚

            button.complete.kb-reveal-btn
              | #{__('Reveal all steps')}
              svg(width="8" height="12"): path(d="M 2 2 L 6 6 L 2 10")

        if section.locked && !config.courses.showLocked && !('preview' in req.query)
          .section-dev.kb-under-construction
            include ./svgs/tools.svg
            h2= __('Under Construction')
            p!= __('Sorry, we are still working on this section.<br>Please check back soon!')
        else
          if section.autoTranslated
            .theorem.kb-translation-notice= __('This page has been automatically translated and may contain errors. Please get in touch if you want to help us review translations!')
          .steps.kb-enhanced-steps
            for stepId in section.steps
              | !{course.steps[stepId].html}

      //- Restored minimal footer (required for course.ts logic). Shrunk styling via helper class.
      footer.kb-course-footer.kb-restored-footer
        p.skip-step.kb-enhanced-skip
          | #{__('To reveal more content, you have to complete all the activities and exercises above.')}&nbsp;
          br
          strong #{__('Are you stuck?')} #[a.skip.kb-skip-link(tabindex=0) #{__('Skip to the next step')}] #{__('or')} #[a.show-all.kb-show-all-link(tabindex=0) #{__('reveal all steps')}]
          svg.kb-arrow-decoration(width=72 height=10): path(d="M1 1L36 9L71 1" fill="none" stroke="#6B46C1" stroke-width=2)
        block course-next-up
          if nextSection
            style!= `.next-arrow{background:${(nextUp.course || course).color}}.next-section:hover .next-arrow,.next-section:focus .next-arrow{background:${lighten((nextUp.course || course).color)}}`
            a.next-section.kb-next-section(href=nextUp.section.url title=(nextUp.course ? nextUp.course.title : nextUp.section.title)): .next-arrow.kb-next-arrow
              if nextUp.course
                .next-icon(style=`background-image: url(${nextUp.course.icon || nextUp.course.hero});`)
              .small= __('Next up:')
              .title= nextUp.course ? nextUp.course.title : nextUp.section.title

      if config.tutor.enabled && !section.locked
        x-tutor.kb-enhanced-tutor(api=`/course/${course.id}/ask`)
          div(slot="icon")!= include(config.tutor.icon)
          div(slot="header")
            != include(config.tutor.icon)
            | #{config.tutor.name}

      script(type="application/json")#glossary!= course.glossJSON
      script(type="application/json")#bios!= course.biosJSON
      script(type="application/json")#hints!= course.hintsJSON
      script(type="application/json")#userdata!= progressData ? progressData.getJSON(section.id) : '{}'

      //- Optional live preview element highlighter (enable with ?preview or ?inspect)
      if 'preview' in req.query || 'inspect' in req.query
        script.
          (function(){
            const label = document.createElement('div');
            label.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;top:8px;right:8px;background:rgba(0,0,0,.7);color:#fff;font:11px/1.3 monospace;padding:6px 8px;border-radius:6px;max-width:320px;white-space:pre;opacity:.9;';
            document.addEventListener('DOMContentLoaded',()=>document.body.appendChild(label));
            const outline = document.createElement('div');
            outline.style.cssText='position:absolute;z-index:9998;pointer-events:none;border:2px solid #38B2AC;box-shadow:0 0 0 2px rgba(56,178,172,.4),0 0 12px 4px rgba(107,70,193,.45);mix-blend-mode:screen;';
            document.body.appendChild(outline);
            function update(e){
              let el = e.target;
              if(!el || el===document.body || el===document.documentElement) return;
              const r = el.getBoundingClientRect();
              outline.style.top = (window.scrollY + r.top)+'px';
              outline.style.left = (window.scrollX + r.left)+'px';
              outline.style.width = r.width+'px';
              outline.style.height = r.height+'px';
              const classes = (el.className && typeof el.className==='string')?'.'+el.className.trim().replace(/\s+/g,'.'):'';
              const id = el.id?('#'+el.id):'';
              label.textContent = (el.tagName.toLowerCase()+id+classes)+'\n'+r.width.toFixed(0)+'×'+r.height.toFixed(0)+' @ '+Math.round(r.top+scrollY)+','+Math.round(r.left+scrollX);
            }
            document.addEventListener('mousemove', update, true);
            document.addEventListener('scroll', (e)=>{if(outline.style.top) update(e);}, true);
            document.addEventListener('click', e=>{ if(e.altKey){ e.preventDefault(); e.stopPropagation(); console.log('Selected element:', e.target); } }, true);
          })();
        style.
          /* highlight hovered elements (when preview active) */
          html body *:hover { outline: none !important; }

  //- Kha-Boom! Course Enhancement Script
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Create enhanced bubbles for course background
      const bubbleContainer = document.getElementById('bubbleContainer');
      if (bubbleContainer) {
        function createCourseBubbles() {
          bubbleContainer.innerHTML = '';
          for (let i = 0; i < 8; i++) {
            const bubble = document.createElement('div');
            bubble.classList.add('bubble');
            const size = Math.random() * 80 + 30;
            bubble.style.width = `${size}px`;
            bubble.style.height = `${size}px`;
            bubble.style.left = `${Math.random() * 100}%`;
            bubble.style.animationDuration = `${Math.random() * 15 + 10}s`;
            bubble.style.animationDelay = `${Math.random() * 5}s`;
            bubbleContainer.appendChild(bubble);
          }
        }
        createCourseBubbles();
      }
      
      // Enhanced colorful text effect
      const colorfulTexts = document.querySelectorAll('.kb-colorful-text');
      colorfulTexts.forEach(text => {
        text.style.background = 'linear-gradient(45deg, #6B46C1, #38B2AC, #FD8C00, #CD0E66)';
        text.style.backgroundSize = '300% 300%';
        text.style.webkitBackgroundClip = 'text';
        text.style.webkitTextFillColor = 'transparent';
        text.style.animation = 'gradientShift 3s ease infinite';
      });
    });

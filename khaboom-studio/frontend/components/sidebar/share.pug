.share-row.kb-enhanced-share
  - var url = `https://${config.domain}${section.url}`
  - var title = (section.title + ' – ' + course.title)
  - var body = course.description
  - var img = section.thumbnail

  .kb-share-header
    h3.kb-share-title Share this amazing lesson!
    p.kb-share-description Help others discover the wonder of learning

  .kb-share-buttons
    if config.social.googleClassroom
      a.btn.kb-share-btn.classroom(title="Google Classroom" href=`https://classroom.google.com/share?url=${url}&title=${title}` target="_blank" rel="noopener")
        .kb-btn-icon
          svg(width="32" height="32" viewBox="0 0 24 24" fill="currentColor")
            path(d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z")
        span.kb-btn-text Classroom
        
    if config.social.twitter
      a.btn.kb-share-btn.twitter(title="Twitter" href=`https://twitter.com/intent/tweet?url=${url}&text=${title}&via=${config.social.twitter.handle}` target="_blank" rel="noopener")
        .kb-btn-icon
          x-icon(name="twitter" size=32)
        span.kb-btn-text Twitter
        
    if config.social.facebook
      a.btn.kb-share-btn.facebook(title="Facebook" href=`https://www.facebook.com/dialog/share?app_id=${config.social.facebook.appId}&display=page&href=${url}` target="_blank" rel="noopener")
        .kb-btn-icon
          x-icon(name="facebook" size=32)
        span.kb-btn-text Facebook
        
    if config.social.pinterest
      a.btn.kb-share-btn.pinterest(title="Pinterest" href=`https://pinterest.com/pin/create/bookmarklet/?media=${img}&url=${url}&description=${title}` target="_blank" rel="noopener")
        .kb-btn-icon
          x-icon(name="pinterest" size=32)
        span.kb-btn-text Pinterest
        
    if config.social.reddit
      a.btn.kb-share-btn.reddit(title="Reddit" href=`https://reddit.com/submit?url=${url}&title=${title}` target="_blank" rel="noopener")
        .kb-btn-icon
          x-icon(name="reddit" size=32)
        span.kb-btn-text Reddit

  .kb-share-link-section
    h4.kb-share-link-title Or copy the link
    .kb-link-input-group
      input.kb-link-input(type="text" value=url readonly)
      button.kb-copy-btn(type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)")
        span.kb-copy-text Copy
